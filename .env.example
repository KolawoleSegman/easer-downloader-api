# Copy to .env (never commit it). Everything is optional.
PORT=5000
API_KEY=change-me                 # require X-API-Key on /api/*
CORS_ORIGIN=*                     # or https://app.example.com,https://other.example.com
COOKIES_BASE64=                   # base64 -w0 cookies.txt
PROXY=                            # http://user:pass@host:port | socks5://host:port
MAX_CONCURRENT=3
MAX_QUEUE=20
MAX_FILESIZE=1G
MAX_PLAYLIST_ITEMS=15
RATE_LIMIT_MAX=30                 # requests / window / IP
HEAVY_LIMIT_MAX=6                 # downloads+jobs / window / IP
RATE_LIMIT_WINDOW_MS=60000
DOWNLOAD_TIMEOUT_MS=480000
FILE_TTL_MS=2700000
JOB_TTL_MS=1800000
YTDLP_UPDATE_HOURS=12             # 0 disables auto-update
ALLOWED_HOSTS=                    # e.g. youtube.com,youtu.be,tiktok.com (empty = any public host)
DEBUG=false
