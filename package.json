{
  "name": "easer-downloader-api",
  "version": "4.0.1",
  "description": "Universal media downloader API powered by yt-dlp: info, extract, download (zip for playlists), clips, subtitles, thumbnails, search, async jobs with SSE progress",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/lib.test.js && node test/downloader.test.js",
    "test:lib": "node test/lib.test.js",
    "test:downloader": "node test/downloader.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "keywords": [
    "yt-dlp",
    "downloader",
    "youtube",
    "api",
    "media",
    "tiktok",
    "instagram"
  ],
  "license": "MIT"
}
