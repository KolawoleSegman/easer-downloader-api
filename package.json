{
  "name": "easer-downloader-api",
  "version": "4.1.0",
  "description": "Universal media downloader + converter API powered by yt-dlp & ffmpeg: download from 1000+ sites, convert video↔audio locally, clips, subtitles, jobs with SSE",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/lib.test.js && node test/downloader.test.js",
    "test:lib": "node test/lib.test.js",
    "test:downloader": "node test/downloader.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "keywords": [
    "yt-dlp",
    "downloader",
    "youtube",
    "api",
    "media",
    "tiktok",
    "instagram"
  ],
  "license": "MIT"
}
